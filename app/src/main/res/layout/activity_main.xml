<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/screen_green">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_heading"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/forest_green"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_subtitle"
        android:textSize="14sp"
        android:textColor="@color/muted_green"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name_hint"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="@color/leaf_green" />

    <EditText
        android:id="@+id/groupInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/group_hint"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="@color/leaf_green" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/save_task"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:backgroundTint="@color/forest_green" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/list_heading"
        android:textColor="@color/forest_green"
        android:textStyle="bold"
        android:textSize="19sp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/taskListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>